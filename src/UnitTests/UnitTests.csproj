<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>

      <OutputType>Exe</OutputType>

      <IsPackable>false</IsPackable>
      <IsTestProject>true</IsTestProject>

      <!-- Needed for IValueConverter / Shell / ContentPage / Color / Colors / ImageSource -->
      <UseMaui>true</UseMaui>

      <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
      <PackageReference Include="xunit.v3" Version="2.0.3" />
      <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
      <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
      <PackageReference Include="Moq" Version="4.20.72" />
      <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
      <PackageReference Include="coverlet.collector" Version="6.0.4" />
      <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\Relate\Relate.csproj" />
   </ItemGroup>

</Project>
